{
  "name": "universe-map",
  "version": "0.1.0",
  "description": "An interactive 3D map of the Universe built with Angular and Three.js.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nayruuu/my-universe.git"
  },
  "bugs": {
    "url": "https://github.com/Nayruuu/my-universe/issues"
  },
  "homepage": "https://github.com/Nayruuu/my-universe#readme",
  "keywords": [
    "angular",
    "astronomy",
    "threejs",
    "typescript",
    "webgl",
    "3d-visualization"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --stats-json && npm run budgets:styles && npm run seo:build && npm run docs:build && npm run docs:verify",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:unit": "ng test --watch=false",
    "test:ci": "npm run test:data && npm run audit:science && npm run test:coverage",
    "test:data": "node --test tools/*.spec.mjs",
    "test:coverage": "ng test --watch=false --coverage --coverage-reporters=text-summary --coverage-reporters=json-summary --coverage-reporters=json && node tools/check-coverage.mjs",
    "audit:science": "node tools/audit-scientific-distances.mjs",
    "test:e2e": "playwright test",
    "test:e2e:geolocation": "playwright test e2e/earth-observer-geolocation.desktop.spec.ts --project=desktop-chromium",
    "test:e2e:visual": "playwright test e2e/visual-regression.desktop.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:report": "playwright show-report",
    "benchmark:tempel": "node tools/tempel-transition-benchmark.mjs",
    "benchmark:startup": "node tools/startup-benchmark.mjs",
    "benchmark:resources": "node tools/resource-stability-benchmark.mjs",
    "benchmark:frames": "node tools/frame-stability-benchmark.mjs",
    "benchmark:observer": "node tools/observer-frame-stability-benchmark.mjs",
    "benchmark:campaign": "node tools/benchmark-campaign.mjs",
    "benchmark:campaign:simulated": "node tools/simulated-benchmark-campaign.mjs",
    "debug:navigation:capture": "node tools/capture-navigation-debug.mjs",
    "debug:navigation:audit": "node tools/audit-navigation-zoom.mjs",
    "budgets:styles": "node tools/check-component-style-budgets.mjs",
    "docs:dev": "vitepress dev docs/guide --port 4204",
    "docs:build": "vitepress build docs/guide",
    "docs:preview": "vitepress preview docs/guide --port 4204",
    "docs:verify": "node tools/verify-documentation-build.mjs",
    "seo:build": "node tools/generate-localized-seo.mjs",
    "data:stars": "node tools/import-hyg-stars.mjs",
    "data:star-tiles": "node tools/build-star-spatial-index.mjs",
    "data:constellations": "node tools/import-constellations.mjs",
    "data:observer-locations": "node tools/import-earth-observer-locations.mjs",
    "data:earth-landmarks": "node tools/build-earth-landmark-snapshot.mjs",
    "data:earth-terrain-horizons": "node tools/build-earth-terrain-horizon-snapshot.mjs",
    "data:exoplanets": "node tools/import-exoplanets.mjs",
    "data:nearby-galaxies": "node tools/import-nearby-galaxies.mjs",
    "data:cosmic-web": "node tools/import-cosmicflows-groups.mjs && npm run data:cosmic-volume",
    "data:cosmic-volume": "node tools/build-cosmic-web-volume.mjs",
    "data:cosmic-structures": "node tools/import-cosmic-structures.mjs && node tools/import-tempel-filament-spines.mjs",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\" \"tools/**/*.mjs\" \"public/**/*.{json,md}\" \"data-sources/**/*.{json,md}\" \"docs/**/*.{css,json,md,mts,ts}\" \"../.agents/**/*.md\" \"../.claude/agents/**/*.md\" \"../*.md\" \"../docs/**/*.{css,json,md,mts,ts}\" \"*.config.{mts,ts}\" \"package.json\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\" \"e2e/**/*.ts\" \"tools/**/*.mjs\" \"public/**/*.{json,md}\" \"data-sources/**/*.{json,md}\" \"docs/**/*.{css,json,md,mts,ts}\" \"../.agents/**/*.md\" \"../.claude/agents/**/*.md\" \"../*.md\" \"../docs/**/*.{css,json,md,mts,ts}\" \"*.config.{mts,ts}\" \"package.json\"",
    "lint": "eslint . && stylelint \"src/**/*.scss\"",
    "lint:fix": "eslint . --fix && stylelint \"src/**/*.scss\" --fix",
    "lint:style": "stylelint \"src/**/*.scss\"",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "verify:ci": "npm run typecheck && npm run format:check && npm run lint && npm run test:ci && npm run build",
    "verify": "npm run verify:ci && npm run test:e2e"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@8.6.0",
  "dependencies": {
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@types/three": "^0.185.4",
    "astronomy-engine": "^2.1.19",
    "rxjs": "~7.8.0",
    "three": "^0.185.1",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.19",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "angular-eslint": "^21.4.0",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "geotiff": "^3.0.5",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.66.0",
    "vitepress": "^2.0.0-alpha.19",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@angular/build": {
      "undici": "7.29.0"
    },
    "@hono/node-server": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5",
    "hono": "4.12.34",
    "js-yaml": "4.3.1"
  }
}
