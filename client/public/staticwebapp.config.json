{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/data/*",
      "/guide",
      "/guide/*",
      "/textures/*",
      "/*.{avif,bin,css,gif,ico,jpeg,jpg,js,json,map,png,svg,webp,woff,woff2}"
    ]
  },
  "globalHeaders": {
    "Cross-Origin-Opener-Policy": "same-origin",
    "Cross-Origin-Embedder-Policy": "require-corp",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "X-Content-Type-Options": "nosniff"
  },
  "routes": [
    {
      "route": "/guide",
      "redirect": "/guide/",
      "statusCode": 301
    },
    {
      "route": "/index.html",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/fr/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/en/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/es/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/de/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/it/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/ko/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/ja/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/zh/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/data/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/textures/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    },
    {
      "route": "/*.{css,js}",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/*.{avif,bin,gif,ico,jpeg,jpg,json,png,svg,webp,woff,woff2}",
      "headers": {
        "Cache-Control": "public, max-age=86400, stale-while-revalidate=604800"
      }
    }
  ],
  "mimeTypes": {
    ".bin": "application/octet-stream",
    ".json": "application/json",
    ".svg": "image/svg+xml",
    ".webp": "image/webp"
  }
}
